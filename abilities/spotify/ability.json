      },
      "query": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      },
      "account": "spotify-account"
    },
    {
      "id": "play",
      "kind": "https",
      "purpose": "Spotify play.",
      "origin": "https://api.spotify.com",
      "method": "PUT",
      "path": [
        "v1",
        "me",
        "player",
        "play"
      ],
      "pathValues": {
        "type": "object",
