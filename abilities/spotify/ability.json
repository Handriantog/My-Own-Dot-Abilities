      "path": [
        "v1",
        "me",
        "player",
        "volume"
      ],
      "pathValues": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      },
      "query": {
        "type": "object",
        "properties": {
          "device_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "volume_percent": {
            "type": "integer",
