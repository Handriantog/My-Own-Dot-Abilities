{
  "formatVersion": 1,
  "apiVersion": 1,
  "id": "spotify",
  "name": "Spotify",
  "description": "Search Spotify, control your existing player, create private playlists and save songs. Spotify results stay on screen.",
  "publisher": "Handriantog",
  "source": {
    "owner": "handriantog",
    "repository": "my-own-dot-abilities"
  },
  "version": "0.1.0",
  "license": "MIT",
  "platforms": [
    "darwin-arm64"
  ],
  "entrypoint": {
    "runtime": "javascript",
    "path": "src/worker.mjs"
  },
  "helpers": [],
  "settings": {
    "type": "object",
    "properties": {
      "clientId": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      }
    },
    "required": [],
    "additionalProperties": false
  },
  "tools": [
    {
      "id": "search",
      "description": "Search Spotify. Results and choices appear privately on screen.",
      "input": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "types": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 8,
              "enum": [
                "track",
                "artist",
                "album",
                "playlist"
              ]
            },
            "minItems": 1,
            "maxItems": 4
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10
          }
        },
        "required": [
          "query"
        ],
        "additionalProperties": false
      },
      "output": {
        "type": "null"
      },
      "visibility": "owner-only"
    },
    {
      "id": "playback",
      "description": "Show playback and available devices privately on screen.",
      "input": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      },
      "output": {
        "type": "null"
      },
      "visibility": "owner-only"
    },
    {
      "id": "play",
      "description": "Play a query, supplied Spotify URI/list, or privately selected result; omit targets to resume. Only name a device when explicitly requested.",
      "input": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "artist": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "uri": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "uris": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "minItems": 1,
            "maxItems": 40
          },
          "device": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "output": {
        "type": "null"
      },
      "visibility": "owner-only"
    },
    {
      "id": "pause",
      "description": "Pause the active device or an explicitly named device.",
      "input": {
        "type": "object",
        "properties": {
          "device": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "output": {
        "type": "null"
      },
      "visibility": "owner-only"
    },
    {
      "id": "skip",
      "description": "Go to the next or previous track on the active or explicitly named device.",
      "input": {
        "type": "object",
        "properties": {
          "direction": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8,
            "enum": [
              "next",
              "previous"
            ]
          },
          "device": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "output": {
        "type": "null"
      },
      "visibility": "owner-only"
    },
    {
      "id": "queue",
      "description": "Queue one track from a query, supplied URI or private selection.",
      "input": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "artist": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "uri": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "device": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "output": {
        "type": "null"
      },
      "visibility": "owner-only"
    },
    {
      "id": "volume",
      "description": "Set volume from 0 to 100 on the active or explicitly named device.",
      "input": {
        "type": "object",
        "properties": {
          "percent": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "device": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "required": [
          "percent"
        ],
        "additionalProperties": false
      },
      "output": {
        "type": "null"
      },
      "visibility": "owner-only"
    },
    {
      "id": "playlists",
      "description": "Show private playlist choices. Use a selected continuation to see the next page.",
      "input": {
        "type": "object",
        "properties": {
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "output": {
        "type": "null"
      },
      "visibility": "owner-only"
    },
    {
      "id": "create_playlist",
      "description": "Create a private playlist, optionally adding supplied track URIs, one resolved query or a private selection. Resolve choices before creating; never retry an uncertain creation.",
      "input": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "description": {
            "type": "string",
            "minLength": 0,
            "maxLength": 300
          },
          "query": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "artist": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "uris": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "minItems": 1,
            "maxItems": 40
          }
        },
        "required": [
          "name"
        ],
        "additionalProperties": false
      },
      "output": {
        "type": "null"
      },
      "visibility": "owner-only"
    },
    {
      "id": "add_to_playlist",
      "description": "Add supplied track URIs, one resolved query or a private selection to a writable private playlist. Specify a supplied playlist URI or playlist name.",
      "input": {
        "type": "object",
        "properties": {
          "playlistUri": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "playlistName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "query": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "artist": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "uris": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "minItems": 1,
            "maxItems": 40
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "output": {
        "type": "null"
      },
      "visibility": "owner-only"
    },
    {
      "id": "save_tracks",
      "description": "Save supplied track URIs, one resolved query or a privately selected track to Liked Songs.",
      "input": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "artist": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "uris": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "minItems": 1,
            "maxItems": 40
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "output": {
        "type": "null"
      },
      "visibility": "owner-only"
    }
  ],
  "permissions": [
    {
      "id": "spotify-account",
      "kind": "oauth",
      "purpose": "Connect Spotify to read playback and playlists, control your player, edit private playlists and save library items.",
      "authorizationUrl": "https://accounts.spotify.com/authorize",
      "tokenUrl": "https://accounts.spotify.com/api/token",
      "resourceOrigin": "https://api.spotify.com",
      "clientIdSetting": "clientId",
      "scopes": [
        "user-read-playback-state",
        "user-read-currently-playing",
        "user-modify-playback-state",
        "playlist-read-private",
        "playlist-modify-private",
        "user-library-modify"
      ]
    },
    {
      "id": "search",
      "kind": "https",
      "purpose": "Spotify search.",
      "origin": "https://api.spotify.com",
      "method": "GET",
      "path": [
        "v1",
        "search"
      ],
      "pathValues": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      },
      "query": {
        "type": "object",
        "properties": {
          "q": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "type": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10
          }
        },
        "required": [
          "q",
          "type",
          "limit"
        ],
        "additionalProperties": false
      },
      "account": "spotify-account"
    },
    {
      "id": "playback",
      "kind": "https",
      "purpose": "Spotify playback.",
      "origin": "https://api.spotify.com",
      "method": "GET",
      "path": [
