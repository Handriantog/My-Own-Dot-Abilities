{
  "formatVersion": 1,
  "apiVersion": 1,
  "id": "spotify-local",
  "name": "Spotify Local",
  "description": "Control the Spotify desktop app on this Mac. No Spotify developer app or API credentials.",
  "publisher": "Handriantog",
  "source": {
    "owner": "handriantog",
    "repository": "my-own-dot-abilities"
  },
  "version": "0.1.1",
  "license": "MIT",
  "platforms": ["darwin-arm64"],
  "entrypoint": {
    "runtime": "javascript",
    "path": "src/worker.mjs"
  },
  "helpers": [],
  "settings": {
    "type": "object",
    "properties": {},
    "required": [],
    "additionalProperties": false
  },
  "tools": [
    {
      "id": "play",
      "description": "Resume Spotify or play a supplied Spotify URI/link, or the selected private search result.",
      "input": {
        "type": "object",
        "properties": {
          "uri": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "output": {
        "type": "null"
      },
      "visibility": "owner-only",
      "channels": ["text", "voice"]
    },
    {
      "id": "pause",
      "description": "Pause Spotify.",
      "input": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      },
      "output": {
        "type": "null"
      },
      "visibility": "owner-only",
      "channels": ["text", "voice"]
    },
    {
      "id": "next",
      "description": "Skip to the next Spotify track.",
      "input": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      },
      "output": {
        "type": "null"
      },
      "visibility": "owner-only",
      "channels": ["text", "voice"]
    },
    {
      "id": "previous",
      "description": "Go to the previous Spotify track.",
      "input": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      },
      "output": {
        "type": "null"
      },
      "visibility": "owner-only",
      "channels": ["text", "voice"]
    },
    {
      "id": "volume",
      "description": "Set Spotify volume from 0 to 100.",
      "input": {
        "type": "object",
        "properties": {
          "percent": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          }
        },
        "required": ["percent"],
        "additionalProperties": false
      },
      "output": {
        "type": "null"
      },
      "visibility": "owner-only",
      "channels": ["text", "voice"]
    },
    {
      "id": "seek",
      "description": "Seek within the current Spotify track in seconds.",
      "input": {
        "type": "object",
        "properties": {
          "seconds": {
            "type": "number",
            "minimum": 0,
            "maximum": 86400
          }
        },
        "required": ["seconds"],
        "additionalProperties": false
      },
      "output": {
        "type": "null"
      },
      "visibility": "owner-only",
      "channels": ["text", "voice"]
    },
    {
      "id": "shuffle",
      "description": "Set Spotify shuffle on or off.",
      "input": {
        "type": "object",
        "properties": {
          "enabled": {
            "type": "boolean"
          }
        },
        "required": ["enabled"],
        "additionalProperties": false
      },
      "output": {
        "type": "null"
      },
      "visibility": "owner-only",
      "channels": ["text", "voice"]
    },
    {
      "id": "repeat",
      "description": "Set Spotify repeat on or off.",
      "input": {
        "type": "object",
        "properties": {
          "enabled": {
            "type": "boolean"
          }
        },
        "required": ["enabled"],
        "additionalProperties": false
      },
      "output": {
        "type": "null"
      },
      "visibility": "owner-only",
      "channels": ["text", "voice"]
    },
    {
      "id": "search",
      "description": "Search the Spotify app; show results privately for the owner to choose.",
      "input": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "category": {
            "type": "string",
            "maxLength": 9,
            "enum": ["tracks", "playlists"]
          }
        },
        "required": ["query", "category"],
        "additionalProperties": false
      },
      "output": {
        "type": "null"
      },
      "visibility": "owner-only",
      "channels": ["text", "voice"]
    },
    {
      "id": "playlists",
      "description": "Show currently visible Spotify library playlists privately. A choice can be used when adding a song.",
      "input": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      },
      "output": {
        "type": "null"
      },
      "visibility": "owner-only",
      "channels": ["text", "voice"]
    },
    {
      "id": "save_current",
      "description": "Save the current Spotify song to the library.",
      "input": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      },
      "output": {
        "type": "null"
      },
      "visibility": "owner-only",
      "channels": ["text", "voice"]
    },
    {
      "id": "create_playlist",
      "description": "Create an empty Spotify playlist, then save it as private with the requested name. A failed operation may leave an empty default-named playlist; check Spotify before retrying.",
      "input": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          }
        },
        "required": ["name"],
        "additionalProperties": false
      },
      "output": {
        "type": "null"
      },
      "visibility": "owner-only",
      "channels": ["text", "voice"]
    },
    {
      "id": "add_to_playlist",
      "description": "Add a song to a playlist. Supply a song search query; the owner chooses the exact recording privately. A playlist name is optional; omitted names use a private playlist choice. Duplicate playlist names are unsupported.",
      "input": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "playlistName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          }
        },
        "required": ["query"],
        "additionalProperties": false
      },
      "output": {
        "type": "null"
      },
      "visibility": "owner-only",
      "channels": ["text", "voice"]
    }
  ],
  "permissions": [
    {
      "id": "playback",
      "kind": "app-control",
      "purpose": "Control playback in Spotify.",
      "application": "com.spotify.client",
      "actions": [
        "play",
        "pause",
        "next",
        "previous",
        "volume",
        "seek",
        "shuffle",
        "repeat",
        "play_uri"
      ]
    },
    {
      "id": "library-ui",
      "kind": "app-control",
      "purpose": "Search, save songs, and edit playlists through the Spotify interface.",
      "application": "com.spotify.client",
      "actions": [
        "search",
        "playlists",
        "save_current",
        "create_playlist",
        "add_to_playlist"
      ]
    }
  ],
  "notices": [
    {
      "id": "local-control",
      "title": "Spotify desktop control",
      "text": "This Ability can change Spotify playback and your library. It uses the Spotify account already signed in on this Mac, shared across Dots. Per-Dot permission grants do not create separate Spotify accounts. UI actions can bring Spotify forward. Metadata stays in private owner cards; your own requests still follow the configured AI provider and chat storage. No audio is captured or downloaded. Spotify remains open when Dot quits. Check Spotify before repeating an uncertain action. This independent MIT project is not endorsed by Spotify. Local automation is not a guarantee of exemption from Spotify terms. Playlist creation starts with an empty default-named playlist using Spotify\u2019s default visibility, then makes it private. UI automation currently requires Spotify in English and stops on unfamiliar layouts or duplicate target names.",
      "required": false
    }
  ],
  "icon": {
    "background": "#1DB954",
    "foreground": "#10231A",
    "paths": [
      "M4 7 C9 4 16 4 21 7 L20 9 C15 6 9 6 5 9 Z",
      "M5 11 C10 8 16 9 20 11 L19 13 C15 11 10 10 6 13 Z",
      "M7 15 C11 13 15 14 18 16 L17 18 C14 16 11 15 8 17 Z"
    ]
  }
}
